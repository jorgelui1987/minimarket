APP_NAME="Mi Minimarket"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_minimarket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@minimarket.test"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================
# FACTURACION ELECTRONICA - CHILE (SII)
# =============================================
# RUT del emisor (formato 76123456-7)
CL_RUT_EMISOR=

# Certificado digital (firma electronica avanzada) en formato PEM
CL_CERT_PATH=

# Password del certificado (si aplica)
CL_CERT_PASS=

# Directorio donde se guardan los CAF (.xml) del SII
CL_CAF_DIR=

# Endpoint del WebService de EnvioDTE del SII
CL_SII_ENDPOINT=https://palena.sii.cl/DTEWS/EnvioDTEService

# Datos del emisor
CL_RAZON_SOCIAL=
CL_GIRO=
CL_DIRECCION=
CL_COMUNA=
CL_CIUDAD=
